# Copy this file to `.env` for local development. Never commit `.env`.
# Every value below is a blank placeholder. Do not put real keys in this file.

# ---------------------------------------------------------------------------
# Browser-safe variables (VITE_ prefix)
# Bundled into the frontend and visible to anyone. Never put secrets here.
# ---------------------------------------------------------------------------

# Clerk publishable key (public by design). The API server reads it too.
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the Express API, without a trailing slash.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Server-only secrets
# Used only by the Express API (hosted on Render). Never prefix with VITE_.
# ---------------------------------------------------------------------------

# Clerk secret key.
CLERK_SECRET_KEY=

# MongoDB Atlas connection string and database name.
MONGODB_URI=
MONGODB_DB_NAME=

# Comma-separated Clerk user IDs allowed to assign roles.
ADMIN_CLERK_USER_IDS=

# Optional: port for the API server. Render sets this automatically.
# PORT=
